---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import CtaBand from "../components/CtaBand.astro";
import SectionHead from "../components/SectionHead.astro";
import site from "../data/site.json";
const a = site.about;
---
<Layout title="About" description="Spiking Labs builds products for the details that matter in daily life, and private AI for teams, from Cologne.">
  <Container>
    <header class="max-w-4xl space-y-6 pb-14 pt-16 md:pt-24">
      <p class="eyebrow">About us</p>
      <h1 class="display">{a.title}</h1>
    </header>
    <div class="grid gap-10 md:grid-cols-[1fr_1.4fr]">
      <dl class="space-y-5 self-start border-t border-line/15 pt-5 font-mono text-sm">
        <div><dt class="eyebrow mb-1">Company</dt><dd>{site.legalName}</dd></div>
        <div><dt class="eyebrow mb-1">Address</dt><dd>{site.address}</dd></div>
        <div><dt class="eyebrow mb-1">Contact</dt><dd><a class="underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      </dl>
      <div class="space-y-6 text-xl leading-8 tracking-tight">
        {a.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <section class="mt-28">
      <SectionHead eyebrow="Principles" title="How we work." />
      <div class="mt-10 grid gap-px overflow-hidden rounded-card border border-line/10 bg-line/10 md:grid-cols-3">
        {site.principles.map((p, i) => (
          <div class="space-y-4 bg-canvas p-8 md:p-10" data-reveal>
            <span class="font-mono text-xs text-muted">R–{String(i + 1).padStart(2, "0")}</span>
            <h3 class="text-2xl font-medium tracking-tight">{p.title}</h3>
            <p class="leading-7 text-muted">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    {site.team.length > 0 && (
      <section class="mt-28">
        <SectionHead eyebrow="Team" title="The people behind it." />
        <ul class="mt-10 grid gap-4 md:grid-cols-3">
          {site.team.map((m: { name: string; role: string; bio: string }) => (
            <li class="panel p-7" data-reveal><h3 class="text-xl font-medium">{m.name}</h3><p class="eyebrow mt-1">{m.role}</p><p class="mt-4 text-muted">{m.bio}</p></li>
          ))}
        </ul>
      </section>
    )}
  </Container>
  <CtaBand />
</Layout>
