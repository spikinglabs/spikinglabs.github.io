---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
---
<Layout title="Page not found" noindex>
  <Container>
    <div class="space-y-6 py-32 md:py-44">
      <p class="eyebrow">404 · no signal</p>
      <h1 class="display max-w-[14ch]">That page did not fire.</h1>
      <p class="max-w-md text-lg text-muted">The link may be old or mistyped.</p>
      <a href="/" class="btn-primary">Back to home</a>
    </div>
  </Container>
</Layout>
