---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import ProductCard from "../../components/ProductCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import site from "../../data/site.json";
import { products, isLive, pad } from "../../lib/products";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const live = isLive(product);
const index = products.findIndex((p) => p.slug === product.slug);
const others = products.filter((p) => p.slug !== product.slug).slice(0, 2);
const waitlist = `mailto:${site.email}?subject=${encodeURIComponent(`Notify me: ${product.name}`)}`;
---
<Layout title={product.name} description={`${product.name}: ${product.tagline}. ${product.summary}`}>
  <section class="relative overflow-hidden border-b border-line/10">
    <div class="grid-bg absolute inset-0 -z-10"></div>
    <Container>
      <div class="pb-20 pt-14 md:pb-28 md:pt-20">
        <a href="/products" class="eyebrow transition hover:text-ink">← All products</a>
        <div class="mt-10 flex items-center gap-4">
          <span class="font-mono text-xs tracking-[0.14em] text-muted">N–{pad(index + 1)}</span>
          <span class="inline-flex items-center gap-2 rounded-ctl border border-line/15 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
            <span class={`led ${live ? "led-live" : "led-soon"}`}></span>{product.status}
          </span>
        </div>
        <h1 class="display mt-6 max-w-[16ch]">{product.name}</h1>
        <p class="mt-6 max-w-2xl text-2xl leading-8 tracking-tight">{product.tagline}</p>
        <p class="mt-5 max-w-2xl text-lg leading-7 text-muted">{product.summary}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          {product.ctaUrl ? (
            <a class="btn-primary" href={product.ctaUrl} target="_blank" rel="noopener noreferrer">{product.ctaLabel} <span aria-hidden="true">↗</span></a>
          ) : (
            <a class="btn-primary" href={waitlist}>Get notified at launch</a>
          )}
          {product.slug === "cityklub" && <a class="btn-ghost" href="/products/cityklub/privacy-policy/">Privacy policy</a>}
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <section class="mt-24">
      <p class="eyebrow mb-4" data-reveal>Signals</p>
      <ul class="border-t border-line/15">
        {product.features.map((f, i) => (
          <li class="grid gap-3 border-b border-line/15 py-8 md:grid-cols-[4rem_1fr_1.4fr] md:gap-10 md:py-10" data-reveal>
            <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, "0")}</span>
            <h2 class="text-2xl font-medium tracking-tight md:text-3xl">{f.title}</h2>
            <p class="text-lg leading-7 text-muted">{f.description}</p>
          </li>
        ))}
      </ul>
    </section>

    {!live && (
      <section class="mt-16 rounded-card border border-line/10 bg-panel p-8 md:p-12" data-reveal>
        <div class="flex flex-wrap items-center justify-between gap-6">
          <div class="space-y-2">
            <h2 class="text-2xl font-medium tracking-tight">{product.name} is in development.</h2>
            <p class="text-muted">Be among the first to try it and help shape what we build next.</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a class="btn-primary" href={waitlist}>Request early access</a>
            <a class="btn-ghost" href={`mailto:${site.email}?subject=${encodeURIComponent(`Partnership inquiry: ${product.name}`)}`}>Partner with us</a>
          </div>
        </div>
      </section>
    )}

    <section class="mt-24">
      <p class="eyebrow mb-4" data-reveal>More from the lab</p>
      <div class="grid gap-4 md:grid-cols-2">
        {others.map((p) => <ProductCard product={p} index={products.findIndex((x) => x.slug === p.slug)} />)}
      </div>
    </section>
  </Container>
  <CtaBand />
</Layout>
