---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import productsData from '../components/Data/products.json';

const cardColors = ["bg-zinc-100", "bg-lime", "bg-[#FFE3C2]"];
---

<Layout title="Products">
	<main class="space-y-20">
		<Container>
			<section class="py-6 md:pb-16 md:pt-12 text-left space-y-4 max-w-3xl">
				<div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2 text-sm font-medium text-black/70 shadow-sm">
					<span class="h-2 w-2 rounded-full bg-lime"></span>
					Products
				</div>
				<h1 class="text-5xl font-medium leading-none md:text-6xl">
					AI-first products <br />
					<span class="bg-gradient-to-r from-black via-zinc-800 to-lime bg-clip-text text-transparent">that feel human</span>
				</h1>
				<p class="mt-4 text-xl font-normal leading-7 text-black/80">
					We build focused tools that simplify everyday life, powered by responsible AI and thoughtful design.
				</p>
			</section>

			<section class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-10">
				{productsData.map((product, i) => (
					<a
						href={`/products/${product.slug}`}
						class={`group flex flex-col justify-between p-10 md:p-12 rounded-[45px] shadow-card border border-black ${cardColors[i % cardColors.length]} text-black transition duration-300 hover:-translate-y-1`}
					>
						<div class="flex items-start justify-between gap-4">
							<div class="space-y-3">
								<span class="inline-flex items-center rounded-full border border-black/20 bg-white/70 px-3 py-1 text-xs font-medium text-black/70">
									{product.status}
								</span>
								<h2 class="text-3xl font-medium">{product.name}</h2>
								<p class="text-lg text-black/80">{product.tagline}</p>
							</div>
							{product.heroImage && (
								<img class="hidden sm:block w-20 h-20 object-contain transition duration-300 group-hover:scale-105" src={product.heroImage} alt={product.name} />
							)}
						</div>
						<p class="mt-8 text-base text-black/70 line-clamp-3">{product.summary}</p>
						<span class="mt-6 inline-flex items-center gap-2 text-base font-medium underline-offset-4 group-hover:underline">
							Explore {product.name} &rarr;
						</span>
					</a>
				))}
			</section>
		</Container>
	</main>
</Layout>
