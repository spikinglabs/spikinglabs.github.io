---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Topic from '../components/Topic.astro';
---

<Layout title="Support | Spiking Labs">
	<main class="space-y-20">
		<Container>
			<div class="pt-10">
				<Topic as="h1" title="Support" description="How can we help? Contact our support team below." />
			</div>

			<div class="grid gap-10 md:grid-cols-2">
				<div>
					<h2 class="text-2xl font-medium mb-4">Contact us</h2>
					<p class="text-base text-black/80 mb-6">
						Have a question or need help with one of our products? Reach out and our team will get back to you as soon as possible.
					</p>
					<a
						href="mailto:support@spikinglabs.com"
						class="px-9 py-5 bg-zinc-900 hover:bg-white text-white hover:text-black border rounded-2xl inline-flex items-center gap-2.5 transition"
					>
						<span class="text-center text-xl font-normal leading-7">support@spikinglabs.com</span>
					</a>
				</div>

				<div class="rounded-[24px] bg-zinc-100 p-8">
					<h2 class="text-2xl font-medium mb-6">Send us a message</h2>
					<form
						id="support-form"
						class="space-y-6"
					>
						<div>
							<label for="name" class="block mb-2 text-base font-medium text-black">Name</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="shadow-sm bg-white border text-black text-base rounded-lg focus:ring-black focus:border-black block w-full p-2.5"
								placeholder="Your name"
							/>
						</div>
						<div>
							<label for="email" class="block mb-2 text-base font-medium text-black">Email</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="shadow-sm bg-white border text-black text-base rounded-lg focus:ring-black focus:border-black block w-full p-2.5"
								placeholder="you@example.com"
							/>
						</div>
						<div>
							<label for="message" class="block mb-2 text-base font-medium text-black">Message</label>
							<textarea
								id="message"
								name="message"
								rows="6"
								required
								class="block p-2.5 w-full text-base text-black bg-white rounded-lg shadow-sm border focus:ring-black focus:border-black"
								placeholder="How can we help?"
							></textarea>
						</div>
						<button type="submit" class="w-full py-5 bg-zinc-900 hover:bg-black disabled:opacity-60 disabled:cursor-not-allowed rounded-[14px] justify-center gap-2.5 inline-flex transition">
							<div class="text-center text-white text-xl font-normal leading-7">Send Message</div>
						</button>
						<p id="support-form-status" class="text-sm text-black/70" role="status" aria-live="polite"></p>
					</form>
				</div>
			</div>
		</Container>
	</main>
</Layout>

<script is:inline>
	const form = document.getElementById("support-form");
	const status = document.getElementById("support-form-status");
	if (form && status) {
		const submitButton = form.querySelector('button[type="submit"]');
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (submitButton) submitButton.disabled = true;

			const name = document.getElementById("name").value.trim();
			const email = document.getElementById("email").value.trim();
			const message = document.getElementById("message").value.trim();
			const subject = encodeURIComponent(`Support request from ${name}`);
			const body = encodeURIComponent(`${message}\n\nFrom: ${name} (${email})`);

			status.textContent = "Opening your email app...";
			window.location.href = `mailto:support@spikinglabs.com?subject=${subject}&body=${body}`;

			// If no mail client is configured, the page never loses focus - show a fallback after a short delay.
			window.setTimeout(() => {
				if (submitButton) submitButton.disabled = false;
				if (document.hasFocus()) {
					status.innerHTML = 'Nothing happened? Email us directly at <a class="underline" href="mailto:support@spikinglabs.com">support@spikinglabs.com</a>.';
				} else {
					status.textContent = "";
				}
			}, 1500);
		});
	}
</script>

