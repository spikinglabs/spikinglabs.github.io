---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import site from "../data/site.json";
const field = "mt-2 block w-full rounded-xl border border-line/15 bg-canvas px-4 py-3 text-base text-ink placeholder:text-muted/70 focus:border-ink focus:outline-none";
---
<Layout title="Support" description="Get help with a Spiking Labs product.">
  <Container>
    <header class="max-w-3xl space-y-6 pb-14 pt-16 md:pt-24">
      <p class="eyebrow">Support</p>
      <h1 class="display">How can we help?</h1>
      <p class="max-w-xl text-lg leading-7 text-muted">Have a question or need help with one of our products? Reach out and our team will get back to you as soon as possible.</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="panel space-y-5 self-start p-8 md:p-10">
        <p class="eyebrow">Email</p>
        <a href={`mailto:${site.supportEmail}`} class="block break-all text-2xl font-medium tracking-tight underline decoration-line/30 underline-offset-8 hover:decoration-ink">{site.supportEmail}</a>
        <p class="text-muted">Account deletion for CityKlub has its own page: <a class="underline underline-offset-4" href="/products/cityklub/delete-account">request deletion</a>.</p>
      </div>

      <div class="panel p-8 md:p-10">
        <h2 class="mb-6 text-2xl font-medium tracking-tight">Send us a message</h2>
        <form id="support-form" class="space-y-5">
          <div><label for="name" class="eyebrow">Name</label><input type="text" id="name" name="name" required class={field} placeholder="Your name" /></div>
          <div><label for="email" class="eyebrow">Email</label><input type="email" id="email" name="email" required class={field} placeholder="you@example.com" /></div>
          <div><label for="message" class="eyebrow">Message</label><textarea id="message" name="message" rows="6" required class={field} placeholder="How can we help?"></textarea></div>
          <button type="submit" class="btn-primary w-full disabled:opacity-60">Send message</button>
          <p class="text-sm text-muted">This opens your email app with the message pre-filled. Just hit send there.</p>
          <p id="support-form-status" class="text-sm text-muted" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </Container>
</Layout>

<script is:inline>
	const form = document.getElementById("support-form");
	const status = document.getElementById("support-form-status");
	if (form && status) {
		const submitButton = form.querySelector('button[type="submit"]');
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (submitButton) submitButton.disabled = true;

			const name = document.getElementById("name").value.trim();
			const email = document.getElementById("email").value.trim();
			const message = document.getElementById("message").value.trim();
			const subject = encodeURIComponent(`Support request from ${name}`);
			const body = encodeURIComponent(`${message}\n\nFrom: ${name} (${email})`);

			status.textContent = "Opening your email app...";
			window.location.href = `mailto:support@spikinglabs.com?subject=${subject}&body=${body}`;

			// If no mail client is configured, the page never loses focus - show a fallback after a short delay.
			window.setTimeout(() => {
				if (submitButton) submitButton.disabled = false;
				if (document.hasFocus()) {
					status.innerHTML = 'Nothing happened? Email us directly at <a class="underline" href="mailto:support@spikinglabs.com">support@spikinglabs.com</a>.';
				} else {
					status.textContent = "";
				}
			}, 1500);
		});
	}
</script>

