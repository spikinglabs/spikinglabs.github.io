---
import Container from "./Container.astro"
import Topic from "./Topic.astro";
import servicesData from './Data/services.json';
---
<Container>
<div class="relative flex flex-col items-center md:flex-row" id="services">
    <Topic title="Our Services" description="Our services and products are designed to help you unlock the full potential of your business with AI, with privacy and safety."/>
</div>

<div class="flex-col items-center space-y-10">
    {
    Object.entries(servicesData).map(([category, services]) => (
        <div class="w-full">
            <h3 class="text-3xl font-medium mb-6 px-2">{category}</h3>
            <div class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-2 gap-6">
                {
                services.map(({ background, name1, name2, arrow, link, image}) => (
                <div class={`${background} group`}>
                    <div class="flex-col justify-center items-start gap-16 inline-flex">
                        <div class="flex-col justify-start items-start flex gap-3">
                            <div class="px-[7px] bg-lime-300 rounded-[7px] flex-col justify-start items-start gap-2.5 flex">
                                <div class=" text-3xl font-medium">{name1}</div>
                            </div>
                            <div class="px-[7px] bg-lime-300 rounded-[7px] flex-col justify-start items-start gap-2.5 flex">
                                <div class="text-2xl font-normal">{name2}</div>
                            </div>
                        </div>
                    </div>
                    <div class="w-[210px] h-[170px] pt-0.5 pb-[1.95px] justify-center items-center flex">
                        <img class="hidden md:block transition duration-300 group-hover:scale-105" src={image} />
                    </div>
                </div>
                ))
                }
            </div>
        </div>
    ))
    }
</div>

<div class="flex-row items-center my-6 p-14 section-surface">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="justify-start items-center gap-[275px] flex">
            <div class="flex-col justify-start items-start gap-[26px] inline-flex text-black">
                <div class="text-3xl font-medium">Let's make things happen</div>
                <div class="text-lg font-normal text-black/80">Contact us today to learn more about how our AI automation services can help your business grow securely and sustainably.</div>
                <a href=mailto:"hi@spikinglabs.com" class="btn-primary">
                    <div class="text-center text-base font-medium leading-7">Write to Us: hi@spikinglabs.com</div>
                </a>
            </div>
        </div>
        <div class="hidden md:grid justify-items-center -m-20">
            <img src="/services/Illustration.svg" width="50%" alt="cat"/>
        </div>
    </div>
</div>
</Container>