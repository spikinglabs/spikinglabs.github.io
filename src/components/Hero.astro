---
import site from "../data/site.json";
import Container from "./Container.astro";
import Neuron from "./Neuron.astro";
const h = site.hero;
---
<section class="relative isolate overflow-hidden border-b border-line/10">
  <div class="grid-bg absolute inset-0 -z-10"></div>
  <Container>
    <div class="relative z-10 pb-72 pt-16 md:pb-80 md:pt-28">
      <p class="eyebrow mb-8 flex items-center gap-3" data-reveal><span class="led led-live"></span>{h.eyebrow}</p>
      <h1 class="display max-w-[14ch] md:max-w-[16ch]" data-reveal>
        {h.before}<span class="mark">{h.emphasis}</span>{h.after}
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-7 text-muted md:text-xl md:leading-8" data-reveal>{h.lead}</p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal>
        <a href={h.primary.href} class="btn-primary">{h.primary.label} <span aria-hidden="true">→</span></a>
        <a href={h.secondary.href} class="btn-ghost">{h.secondary.label}</a>
      </div>
    </div>
  </Container>
  <Neuron />
</section>
