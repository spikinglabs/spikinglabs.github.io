---
import Container from "./Container.astro"
---
<footer class="bg-lime bg-fixed bg-bottom">
    <Container>
        <div class="py-6 flex flex-col items-center gap-4 md:flex-row md:justify-between">
            <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
                <img class="w-auto h-[1.5em]" src="/Logo.svg" alt="Spiking Labs">
            </a>
            <ul class="flex items-center gap-6 text-sm font-medium">
                <li><a href="/support" class="py-2 hover:underline focus-visible:underline">Support</a></li>
            </ul>
            <div class="text-sm text-black/80 text-center md:text-right">
                Made with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="underline hover:no-underline focus-visible:no-underline">Astro</a>
                and <a href="https://github.com/manulthanura/Positivus" target="_blank" rel="noopener noreferrer" class="underline hover:no-underline focus-visible:no-underline">Positivus</a>
            </div>
        </div>
        <div class="pb-6 pt-4 border-t border-black/10 text-center text-sm text-black/70">
            Copyright © <span id="currentYearCopyright"></span> SL Spiking Labs UG (haftungsbeschränkt). All rights reserved.
        </div>
    </Container>
</footer>

<script is:inline>
    const yearEl = document.getElementById("currentYearCopyright");
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
